API_KEY=hitek-search-2026-secret
PORT=8000
HOST=0.0.0.0

# Search Limits (Default: NO LIMIT / Unlimited search duration):
# SEARCH_TIMEOUT_SECONDS=      # Leave unset for unlimited search duration, or set e.g. 30.0
QUEUE_MODE=reject             # "reject" (instant 429 if busy) or "queue" (wait in line)
QUEUE_TIMEOUT=60.0            # Max seconds to wait in queue when QUEUE_MODE=queue

# Linux / Kali Linux Paths (relative or absolute):
PARQUET_DIR=./parquet
JSON_PATH=./users_data.json

# Windows Example Paths:
# PARQUET_DIR=D:/parquet
# JSON_PATH=D:/users_data.json
